{
  "Behavior": {
    "StartUpDelayTime": "00:00:15",
    "DailySyncronizationStartTime": "11:00:00",
    "DailySyncronizationRetryDelayTime": "00:15:00"
  },
  "DataSourceUpstream": {
    "Uri": "http://pavilion.smartsolucionescuba.net/covid19-cuba.json"
  },
  "Cloud": {
    "BaseUrl": "http://localhost:5000/api/",
    "Secret": "v0.1.0-alpha-backend"
  },
  "Serilog": {
    "MinimumLevel": "Error",
    "WriteTo": [
      {
        "Name": "RollingFile",
        "Args": {
          "pathFormat": "logs\\{Date}.log"
        }
      }
    ]
  },
  "AllowedHosts": "*"
}
